{
  "name": "react-01",
  "type": "library",
  "source": "{projectRoot}",
  "tags": ["ui", "problem"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cypress open --component --browser edge",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cypress run --component --browser edge",
        "cwd": "{projectRoot}"
      }
    },
    "test/update": {
      "executor": "interview-prep:update-visual-regression-baselines",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
