{
  "$schema": "https://json-schema.org/schema",
  "$id": "NewProblem",
  "title": "",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": ["react", "typescript", "web component"],
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What programming language is the problem written in?"
    },
    "name": {
      "type": "string",
      "description": "Short identifier for the problem",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "x-prompt": "What is the name of the problem?"
    },
    "skip-gh": {
      "type": "boolean",
      "description": "Skip GitHub-related commands",
      "default": false
    }
  },
  "required": ["language", "name"]
}
